# Copy this file to .env and fill the values before running the service
# Do NOT commit .env with secrets to version control

# Enable or disable SMS sending (true / false)
BEEM_SMS_ENABLED=false

# The BEEM SMS API endpoint (required to actually send SMS)
# Example: https://api.beem.africa/endpoint/send
BEEM_API_URL=https://apisms.beem.africa/v1/send

# Your BEEM API credentials
BULK_SMS_BEEM_API_KEY="287e10f0a968843c"
BULK_SMS_BEEM_SECRET_KEY="287e10f0a968843c"

# Sender name (short). For testing use an approved test sender if required.
BEEM_SENDER_NAME=KANISANI

# Comma separated recipients (used when recipients not provided in POST body)
BEEM_RECIPIENTS=255767876503,255658199566,255745000529

# Optional single test number
TEST_PHONE_NUMBER=255756215388
